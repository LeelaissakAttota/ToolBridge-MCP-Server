+def _run_fetch(fetcher: HttpWebsiteFetcher, url: str) -> object:
+    async def run() -> object:
+        await fetcher.initialize()
+        try:
+            return await fetcher.fetch(url, max_characters=1_000)
+        finally:
+            await fetcher.close()
+
+    return asyncio.run(run())

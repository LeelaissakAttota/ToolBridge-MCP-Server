From f3c522fdce4863775985b24278079c3d6c4eb226 Mon Sep 17 00:00:00 2001
From: leela <leela@local>
Date: Wed, 14 Oct 2026 17:14:37 +0000
Subject: [PATCH 4/6] fix(sql): tokenize SQL so keywords in literals and
 replace() calls are allowed

---
 tests/unit/tools/test_sql_query.py   | 33 +++++++++++
 toolbridge/tools/domain/sql_query.py | 88 ++++++++++++++++++++++++----
 2 files changed, 110 insertions(+), 11 deletions(-)

diff --git a/tests/unit/tools/test_sql_query.py b/tests/unit/tools/test_sql_query.py
index 995490c..d8e9275 100644
--- a/tests/unit/tools/test_sql_query.py
+++ b/tests/unit/tools/test_sql_query.py
@@ -161,3 +161,36 @@ def test_sql_query_allows_values_within_limit() -> None:
         executor.execute("SELECT length(hex(zeroblob(1000))) AS n", {}, max_rows=1)
     )
     assert result.rows == [{"n": 2000}]
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "SELECT replace('ab', 'a', 'x') AS v",
+        "SELECT 'delete me' AS v",
+        "SELECT 'it''s; -- not a comment' AS v",
+        'SELECT "update" FROM items',
+        "SELECT [drop] FROM items",
+        "SELECT 1 - -1 AS v",
+        "WITH x AS (SELECT 1 AS a) SELECT a FROM x",
+    ],
+)
+def test_sql_query_accepts_keywords_inside_literals_and_functions(query: str) -> None:
+    assert SQLQueryInput(query=query).query == query
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "SELECT 1; DROP TABLE items",
+        "SELECT 1 -- trailing",
+        "SELECT 1 /* block */",
+        "SELECT * FROM items WHERE name REPLACE x",
+        "SELECT 'unterminated",
+        "REPLACE INTO items VALUES ('a', 1)",
+        "WITH x AS (SELECT 1) DELETE FROM items",
+    ],
+)
+def test_sql_query_still_rejects_mutations_and_comments(query: str) -> None:
+    with pytest.raises(ValidationError):
+        SQLQueryInput(query=query)
diff --git a/toolbridge/tools/domain/sql_query.py b/toolbridge/tools/domain/sql_query.py
index 6e19dcd..081fa36 100644
--- a/toolbridge/tools/domain/sql_query.py
+++ b/toolbridge/tools/domain/sql_query.py
@@ -1,6 +1,5 @@
 """Provider-neutral contracts for bounded read-only SQL queries."""
 
-from re import IGNORECASE
 from re import compile as compile_pattern
 
 from pydantic import Field, field_validator
@@ -9,24 +8,91 @@ from toolbridge.core.contracts import ToolInput, ToolOutput
 
 SqlValue = str | int | float | bool | None
 
-_FORBIDDEN_SQL = compile_pattern(
-    r"\b(?:INSERT|UPDATE|DELETE|DROP|ALTER|CREATE|REPLACE|ATTACH|DETACH|"
-    r"PRAGMA|VACUUM|REINDEX|ANALYZE|BEGIN|COMMIT|ROLLBACK|SAVEPOINT|RELEASE)\b",
-    IGNORECASE,
+_FORBIDDEN_KEYWORDS = frozenset(
+    {
+        "INSERT",
+        "UPDATE",
+        "DELETE",
+        "DROP",
+        "ALTER",
+        "CREATE",
+        "REPLACE",
+        "ATTACH",
+        "DETACH",
+        "PRAGMA",
+        "VACUUM",
+        "REINDEX",
+        "ANALYZE",
+        "BEGIN",
+        "COMMIT",
+        "ROLLBACK",
+        "SAVEPOINT",
+        "RELEASE",
+    }
 )
-_READ_ONLY_START = compile_pattern(r"^\s*(?:SELECT|WITH)\b", IGNORECASE)
+# Keywords that are also legitimate read-only scalar functions when called as name(...).
+_FUNCTION_KEYWORDS = frozenset({"REPLACE"})
+_WORD = compile_pattern(r"[A-Za-z_][A-Za-z0-9_$]*")
+_QUOTES = {"'": "'", '"': '"', "`": "`", "[": "]"}
+
+
+def _scan_sql(query: str) -> list[tuple[str, str]]:
+    """Split SQL into bare words and punctuation, skipping literals and quoted names.
+
+    Returns ``(kind, value)`` pairs where kind is ``word`` or ``char``. Content inside
+    string literals and quoted identifiers is never returned, so keywords there do
+    not trigger the read-only checks.
+    """
+
+    tokens: list[tuple[str, str]] = []
+    index = 0
+    length = len(query)
+    while index < length:
+        char = query[index]
+        if char in _QUOTES:
+            closing = _QUOTES[char]
+            index += 1
+            while True:
+                if index >= length:
+                    raise ValueError("query contains an unterminated quoted value")
+                if query[index] == closing:
+                    # SQL escapes a quote by doubling it ('it''s'); brackets cannot double.
+                    if closing != "]" and index + 1 < length and query[index + 1] == closing:
+                        index += 2
+                        continue
+                    index += 1
+                    break
+                index += 1
+            tokens.append(("literal", ""))
+            continue
+        match = _WORD.match(query, index)
+        if match:
+            tokens.append(("word", match.group(0).upper()))
+            index = match.end()
+            continue
+        if query.startswith(("--", "/*", "*/"), index):
+            raise ValueError("query comments and statement separators are not allowed")
+        if not char.isspace():
+            tokens.append(("char", char))
+        index += 1
+    return tokens
 
 
 def validate_read_only_sql(query: str) -> str:
     """Reject multi-statement, commented, or mutating SQL before execution."""
 
     normalized = query.strip()
-    if not normalized or not _READ_ONLY_START.match(normalized):
+    tokens = _scan_sql(normalized) if normalized else []
+    if not tokens or tokens[0] not in {("word", "SELECT"), ("word", "WITH")}:
         raise ValueError("query must start with SELECT or WITH")
-    if ";" in normalized or "--" in normalized or "/*" in normalized or "*/" in normalized:
-        raise ValueError("query comments and statement separators are not allowed")
-    if _FORBIDDEN_SQL.search(normalized):
-        raise ValueError("query contains a forbidden SQL operation")
+    for position, (kind, value) in enumerate(tokens):
+        if kind == "char" and value == ";":
+            raise ValueError("query comments and statement separators are not allowed")
+        if kind == "word" and value in _FORBIDDEN_KEYWORDS:
+            is_call = tokens[position + 1 : position + 2] == [("char", "(")]
+            if value in _FUNCTION_KEYWORDS and is_call:
+                continue
+            raise ValueError("query contains a forbidden SQL operation")
     return normalized
 
 
-- 

TOOLBRIDGE_APP_NAME=ToolBridge MCP Server
TOOLBRIDGE_ENVIRONMENT=development
TOOLBRIDGE_HOST=127.0.0.1
TOOLBRIDGE_PORT=8000
TOOLBRIDGE_LOG_LEVEL=INFO
TOOLBRIDGE_TOOL_TIMEOUT_SECONDS=30
TOOLBRIDGE_MAX_REQUEST_BYTES=65536
TOOLBRIDGE_MAX_RESPONSE_BYTES=262144

TOOLBRIDGE_PROVIDER_PRIORITY=cerebras,nvidia,openrouter
TOOLBRIDGE_PROVIDER_RETRY_BACKOFF_SECONDS=0.25
TOOLBRIDGE_PROVIDER_MAX_RETRY_BACKOFF_SECONDS=2
TOOLBRIDGE_PROVIDER_MAX_REQUEST_BYTES=262144

TOOLBRIDGE_CEREBRAS__ENABLED=false
TOOLBRIDGE_CEREBRAS__API_KEY=
TOOLBRIDGE_CEREBRAS__BASE_URL=https://api.cerebras.ai/v1
TOOLBRIDGE_CEREBRAS__DEFAULT_MODEL=
TOOLBRIDGE_CEREBRAS__TIMEOUT_SECONDS=30
TOOLBRIDGE_CEREBRAS__RETRY_COUNT=2
TOOLBRIDGE_CEREBRAS__MAX_TOKENS=1024
TOOLBRIDGE_CEREBRAS__TEMPERATURE=0.2
TOOLBRIDGE_CEREBRAS__MAX_PROMPT_BYTES=131072
TOOLBRIDGE_CEREBRAS__MODELS_PATH=/models
TOOLBRIDGE_CEREBRAS__CHAT_COMPLETIONS_PATH=/chat/completions

TOOLBRIDGE_NVIDIA__ENABLED=false
TOOLBRIDGE_NVIDIA__API_KEY=
TOOLBRIDGE_NVIDIA__BASE_URL=https://integrate.api.nvidia.com/v1
TOOLBRIDGE_NVIDIA__DEFAULT_MODEL=
TOOLBRIDGE_NVIDIA__TIMEOUT_SECONDS=30
TOOLBRIDGE_NVIDIA__RETRY_COUNT=2
TOOLBRIDGE_NVIDIA__MAX_TOKENS=1024
TOOLBRIDGE_NVIDIA__TEMPERATURE=0.2
TOOLBRIDGE_NVIDIA__MAX_PROMPT_BYTES=131072
TOOLBRIDGE_NVIDIA__MODELS_PATH=/models
TOOLBRIDGE_NVIDIA__CHAT_COMPLETIONS_PATH=/chat/completions

TOOLBRIDGE_OPENROUTER__ENABLED=false
TOOLBRIDGE_OPENROUTER__API_KEY=
TOOLBRIDGE_OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
TOOLBRIDGE_OPENROUTER__DEFAULT_MODEL=
TOOLBRIDGE_OPENROUTER__TIMEOUT_SECONDS=30
TOOLBRIDGE_OPENROUTER__RETRY_COUNT=2
TOOLBRIDGE_OPENROUTER__MAX_TOKENS=1024
TOOLBRIDGE_OPENROUTER__TEMPERATURE=0.2
TOOLBRIDGE_OPENROUTER__MAX_PROMPT_BYTES=131072
TOOLBRIDGE_OPENROUTER__MODELS_PATH=/models
TOOLBRIDGE_OPENROUTER__CHAT_COMPLETIONS_PATH=/chat/completions
TOOLBRIDGE_OPENROUTER__HTTP_REFERER=
TOOLBRIDGE_OPENROUTER__APP_TITLE=ToolBridge MCP Server
